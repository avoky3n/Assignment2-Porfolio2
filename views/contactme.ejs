<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  </head>
<body class="bg-light d-flex flex-column min-vh-100">
  <header class="bg-dark">
        <nav class="navbar navbar-expand-lg navbar-dark container-fluid px-4">
            <a class="navbar-brand" href="/">Aydin Neykov</a>
            <ul class="navbar-nav ms-auto flex-row">
                <li class="nav-item me-3"><a class="nav-link" href="/">Home</a></li>
                <li class="nav-item me-3"><a class="nav-link" href="/aboutme">About Me</a></li>
                <li class="nav-item me-3"><a class="nav-link" href="/projects">Projects</a></li>
                <li class="nav-item"><a class="nav-link active" href="/contactme">Contact Me</a></li>
            </ul>
        </nav>
    </header>

    <main class="container flex-fill my-5">

      <article class="bg-white p-5 mb-4 rounded shadow-sm text-center">
        <h1 class="display-4 fw-bold mb-2 text-success">Get In Touch With Me!</h1>
        <form class="text-start" action="mailto:aydinneykov2006@gmail.com" method="post" enctype="text/plain">
            <label for="name" class="form-label">Full Name</label>
            <input class="form-control form-control-sm mb-3" type="text" id="name" name="name" placeholder="John Doe" required>
            <label for="email" class="form-label">Email</label>
            <input class="form-control form-control-sm mb-3" type="text" id="email" name="email" placeholder="email@example.com" required>
            <label for="message" class="form-label">Your Message</label>
            <textarea class="form-control form-control-sm mb-4" name="message" id="message" rows="6" placeholder="Type your message here..." required></textarea>
            <button class="btn bg-warning text-emphasis-secondary" type="submit">Submit</button>
        </form>

        </article>
        
     
    </main>
    
    <footer class="bg-dark py-4 text-center text-white container-fluid">
      <p class="mb-2">
        <a href="https://github.com" target="_blank" class="text-white me-3 text-decoration-none">GitHub</a>
        <a href="https://linkedin.com" target="_blank" class="text-white text-decoration-none">LinkedIn</a>
      </p>
      <p class="small mb-0 text-white">&copy; 2026 Aydin Neykov</p>
    </footer>
</body>
</html>


